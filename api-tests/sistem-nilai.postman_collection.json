              },
              {
                "key": "X-Device-ID",
                "value": "{{dev_mhs1}}"
              }
            ],
            "url": "{{gw}}/auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mhs1\",\n  \"password\": \"mhs123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set(\"token_mhs1\", j.access_token);",
                  "  pm.collectionVariables.set(\"refresh_mhs1\", j.refresh_token);",
